<?xml version="1.0" encoding="UTF-8"?>
<!--
  Without this file Karate logs every HTTP request and response at DEBUG,
  including passwords and tokens, which floods the CI log. Request details
  are still in the HTML report (target/karate-reports/).
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.intuit.karate" level="INFO"/>
  <logger name="org.apache.http" level="WARN"/>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
