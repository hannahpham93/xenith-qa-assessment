# Copy this file to .env and adjust if needed. Never commit the real .env file.

# Base URL of the application under test
BASE_URL=https://demoqa.com

# Default password used to register throwaway test users at runtime.
# This is NOT a real credential - a fresh disposable user is generated
# and deleted (cleaned up) at the end of every test run. Override here
# only if demoqa's password policy changes.
TEST_USER_PASSWORD=Test@1234!
