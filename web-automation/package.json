{
  "name": "bookstore-web-automation",
  "version": "1.0.0",
  "description": "Playwright POM + data-driven automation for the demoqa.com Book Store user flow (Xenith Senior QA assessment)",
  "private": true,
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:cross-browser": "playwright test",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5"
  }
}
